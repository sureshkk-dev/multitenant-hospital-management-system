PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/multitenancy
JWT_SECRET=change_me
JWT_EXPIRES_IN_SECONDS=86400

# Subdomain tenants: city.hospital.com → TENANT_BASE_DOMAIN=hospital.com
TENANT_BASE_DOMAIN=hospital.com

# Dev only: allow hospitalAdmin login without tenant (e.g. API from localhost). Prefer real subdomains via /etc/hosts.
ALLOW_APEX_HOSPITAL_LOGIN=false

# Optional: auto-create initial super admin on boot (only if none exists)
SUPERADMIN_EMAIL=superadmin@local.test
SUPERADMIN_PASSWORD=superadmin123
